# Google OAuth2 Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Secret Key
# Generate a strong random string (at least 32 characters)
# Example PowerShell command: -join ((1..64) | ForEach-Object { [char](Get-Random -Minimum 33 -Maximum 126) })
JWT_SECRET=your-very-long-secret-key-at-least-32-characters-long

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=authdb
DB_USER=whocloud
DB_PASSWORD=whocloud123

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values in the .env file
# 3. The .env file is already in .gitignore (DO NOT commit it to git)
